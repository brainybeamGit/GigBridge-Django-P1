# ===============================================================
# GigBridge Freelance Marketplace - Environment Configuration
# ===============================================================
# Copy this file to .env and configure the values for your setup:
#   cp .env.example .env (or copy .env.example .env on Windows)
# ===============================================================

# ─── Django Core Settings ───
SECRET_KEY=django-insecure-gigbridge-super-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Razorpay Payment Gateway (Test Mode) ───
# Get your API keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=

# ─── Dual-Currency & Exchange Rate Engine ───
# Stored base amounts remain in INR. Display amounts convert dynamically.
# Exchange rate USD -> INR (Default: 83.0 INR per 1 USD)
USD_INR_RATE=83.0
# Gateway billing currency (INR default for Indian Razorpay accounts)
PAYMENT_CURRENCY=INR

# ─── Email & Notification Settings (SMTP) ───
# Development: Use console backend to output emails in terminal
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP (e.g. Gmail App Password):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=GigBridge Support <support@gigbridge.com>
SUPPORT_EMAIL=support@gigbridge.com
